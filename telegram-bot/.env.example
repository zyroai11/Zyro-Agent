# Salin file ini menjadi ".env" lalu isi nilainya

# Token dari @BotFather (WAJIB)
TELEGRAM_BOT_TOKEN=

# Alamat kontrak $ZYRO di Robinhood Chain
ZYRO_TOKEN_ADDRESS=0x50e05d1ee5e545540190a1136667af06a496f6d2

# Minimal saldo $ZYRO untuk jadi holder (unlimited scan + AI)
HOLDER_MIN_BALANCE=100000

# Jatah scan gratis per hari untuk non-holder
FREE_SCANS_PER_DAY=3

# API key Google Gemini (opsional, gratis di aistudio.google.com)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Biasanya tidak perlu diubah
RPC_URL=https://rpc.mainnet.chain.robinhood.com
EXPLORER_URL=https://robinhoodchain.blockscout.com
BLOCKSCOUT_API_KEY=
