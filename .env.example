# ---- Zyro agent settings. Copy this file to .env and fill it in. ----

# Wallet for live trading. Use a NEW wallet with only the ETH you are willing to trade.
# Leave empty to use simulation only.
PRIVATE_KEY=

# Uniswap Trading API key (free): https://developers.uniswap.org
# Needed for real quotes and live trades.
UNISWAP_API_KEY=

# Google Gemini key for chat mode (free at aistudio.google.com). Optional.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# Blockscout key for holder count and contract checks. Optional.
BLOCKSCOUT_API_KEY=

# ---- Your trading rules ----
MIN_SCORE=60            # skip tokens that score below this
MAX_TRADE_ETH=0.05      # largest single buy in ETH
MAX_DAILY_LOSS_USD=50   # stop buying after losing this much today (UTC)
MAX_OPEN_POSITIONS=5
STOP_LOSS_PCT=15        # default stop loss for each position
TAKE_PROFIT_PCT=50      # default take profit for each position
SLIPPAGE_PCT=3
WATCH_INTERVAL=20       # seconds between price checks in watch mode
GAS_RESERVE_ETH=0.0005  # ETH always kept for gas

# Usually no need to change
RPC_URL=https://rpc.mainnet.chain.robinhood.com
EXPLORER_URL=https://robinhoodchain.blockscout.com
